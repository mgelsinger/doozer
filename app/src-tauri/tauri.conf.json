{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Doozer",
  "version": "1.0.0",
  "identifier": "com.doozer.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Doozer",
        "width": 214,
        "height": 54,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Doozer",
    "category": "Utility",
    "shortDescription": "A small creature that lives on your desktop",
    "longDescription": "Doozer is a desktop pet: one small creature with four homes (Pill, Room, Island, Desktop) and a focus timer in every one of them.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "installer/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh",
        "languages": [
          "English"
        ],
        "customLanguageFiles": {
          "English": "installer/English.nsh"
        },
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
